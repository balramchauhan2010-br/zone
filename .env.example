# Copy to .env for local development. Never commit the populated .env file.
# These server-side values may instead be added to Streamlit Community Cloud Secrets.
# DhanHQ v2 read-only market-data credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv

# Optional explanation-only Gemini integration. Numerical data never comes from Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: protects the explanation-only feature from anonymous use.
APP_ADMIN_TOKEN=

TZ=Asia/Kolkata

# Optional personal/research fallback only. Keep disabled on public/shared dashboards.
# Yahoo daily NSE cash-equity bars are research-only, not live/verified F&O data.
YAHOO_RESEARCH_ENABLED=false
